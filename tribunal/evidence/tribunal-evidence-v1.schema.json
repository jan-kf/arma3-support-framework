{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pontifex.invalid/schemas/tribunal-evidence-v1.schema.json",
  "title": "Tribunal Evidence Contract v1",
  "type": "object",
  "required": ["schema", "package_id", "package_revision", "run", "scenarios", "participants", "context", "source_snapshots", "artifacts", "observations", "assertions", "experimental_arms", "causal_relationships", "proposition_evaluations", "publication", "integrity"],
  "properties": {
    "schema": {"const": "tribunal.evidence/v1"},
    "package_id": {"type": "string", "minLength": 1},
    "package_revision": {"type": "integer", "minimum": 1},
    "supersedes_package_id": {"type": "string"},
    "knowledge_subject": {"type": "object", "required": ["key", "label", "kind", "biki_context"], "additionalProperties": true},
    "run": {"type": "object", "required": ["id", "started_at", "finished_at", "execution_state", "outcome", "runner_status", "mode"], "additionalProperties": true},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "version", "feature_family", "name", "definition"], "additionalProperties": true}},
    "participants": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "role", "runtime"], "additionalProperties": true}},
    "context": {"type": "object", "required": ["product", "branch", "version"], "additionalProperties": true},
    "source_snapshots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "repository", "commit", "tree_state", "files"], "additionalProperties": true}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["id", "type", "sha256", "reference", "description"], "additionalProperties": true}},
    "observations": {"type": "array", "items": {"type": "object", "required": ["id", "scenario_id", "type", "value", "observed_at", "participant_id", "artifact_ids"], "additionalProperties": true}},
    "assertions": {"type": "array", "items": {"type": "object", "required": ["id", "definition_id", "scenario_id", "type", "expected", "observed", "result", "observation_ids", "artifact_ids"], "additionalProperties": true}},
    "experimental_arms": {"type": "array", "items": {"type": "object", "required": ["id", "scenario_id", "role", "description"], "additionalProperties": true}},
    "causal_relationships": {"type": "array", "items": {"type": "object", "required": ["id", "relation", "source_arm_id", "target_arm_id", "controlled_dimensions"], "additionalProperties": true}},
    "proposition_evaluations": {"type": "array", "items": {"type": "object", "required": ["id", "proposition_id", "text", "outcome", "intended_use", "observation_ids", "assertion_ids", "rationale"], "additionalProperties": true}},
    "publication": {"type": "object", "required": ["status", "published_at", "publisher", "synthetic"], "additionalProperties": true},
    "integrity": {"type": "object", "required": ["algorithm", "payload_sha256", "canonicalization"], "additionalProperties": true}
  },
  "additionalProperties": true
}
