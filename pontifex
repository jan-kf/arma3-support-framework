#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [[ -n "${TRIBUNAL_ROOT:-}" ]]; then
    TRIBUNAL_CHECKOUT="$TRIBUNAL_ROOT"
elif [[ -f "$ROOT/../tribunal/tribunal/__init__.py" ]]; then
    TRIBUNAL_CHECKOUT=$(cd "$ROOT/../tribunal" && pwd)
elif [[ -f "$ROOT/../../tribunal/tribunal/__init__.py" ]]; then
    TRIBUNAL_CHECKOUT=$(cd "$ROOT/../../tribunal" && pwd)
else
    echo "Independent Tribunal checkout not found; set TRIBUNAL_ROOT." >&2
    exit 2
fi
export TRIBUNAL_ROOT="$TRIBUNAL_CHECKOUT"
export PYTHONPATH="$TRIBUNAL_CHECKOUT${PYTHONPATH:+:$PYTHONPATH}"
if [[ -n "${PONTIFEX_STATE_ROOT:-}" ]]; then
    STATE_ROOT="$PONTIFEX_STATE_ROOT"
elif [[ "$(basename "$(dirname "$ROOT")")" == "arma-projects" ]]; then
    STATE_ROOT=$(cd "$ROOT/../.." && pwd)/arma-state/$(basename "$ROOT")
else
    STATE_ROOT="$ROOT"
fi
if [[ "$STATE_ROOT" != "$ROOT" ]]; then
    BUILD_ROOT="$STATE_ROOT/builds"
    HEMTT="$STATE_ROOT/dependencies/tools/hemtt"
else
    BUILD_ROOT="$ROOT/build"
    HEMTT="$ROOT/.tools/hemtt"
fi
export PONTIFEX_STATE_ROOT="$STATE_ROOT"
COMPONENTS=(core field-utilities advanced-systems visual-support-tablet)
MOD_DIRS=("@CORDIS" "@FieldUtils" "@AdvSys" "@VIGIL_Support_Tablet")
PBO_NAMES=(CORDIS FieldUtils AdvSys VIGIL)

usage() {
    cat <<'EOF'
Usage: ./pontifex COMMAND

  check           Run HEMTT static checks for all four mods
  build           Check and build all four mods into build/current
  test            Run the fast/static test suite
  test smoke      Fresh single-client infrastructure smoke test
  test integration Fresh single-boot in-mission integration batch
  test gameplay   Fresh deterministic gameplay scenario suite
  test capability Fresh Tribunal locality and framebuffer capability probes
  test live       Start durable Developer Live Mode
  test dedicated  Build and run the real dedicated-server integration test
  test multiplayer Build and run server plus one real automated player client
  manual          Start a two-hour human-driven private client/server test
  e2e             Run the autonomous single-real-client Pontifex v1 proof
  live ...        Inspect/control an active Developer Live Mode session
  multiplayer status Show live real-player multiplayer phase and evidence
  status          Show tool, Git, artifact, and server-foundation status
  server status   Show the Pontifex-controlled server and dependency status
  server stop     Stop only the validated Pontifex-controlled server process
  client status   Show real-player image, Steam session, and Arma install status
  client image    Build the project-local Steam/Proton/Vulkan client image
  client preflight Prove RTX Vulkan rendering through the virtual display
  client login    Start loopback-only VNC for initial Steam login/install
  client stop-login Stop the validated Steam login container
  dependencies    Show pinned dependency status (add 'provision' to install)
  release         Reserved until versioning and signing policy are established
EOF
}

ensure_hemtt() {
    "$ROOT/tools/bootstrap-hemtt"
}

run_check() {
    ensure_hemtt
    local component
    for component in "${COMPONENTS[@]}"; do
        echo "== check: $component =="
        (cd "$ROOT/mods/$component" && "$HEMTT" check)
    done
    python3 -m py_compile "$ROOT/tools/pontifex_server.py"
    python3 -m py_compile "$ROOT/tools/pontifex_multiplayer.py"
    python3 -m unittest discover -s "$ROOT/tests" -p 'test_*.py'
    python3 -m json.tool "$ROOT/server/dependencies.lock.json" >/dev/null
}

run_build() {
    ensure_hemtt
    local stage="$BUILD_ROOT/.current.$$"
    local component mod_dir pbo_name built_pbo
    local i
    mkdir -p "$stage"
    trap 'rm -rf "$stage"' EXIT
    for i in "${!COMPONENTS[@]}"; do
        component="${COMPONENTS[$i]}"
        mod_dir="${MOD_DIRS[$i]}"
        pbo_name="${PBO_NAMES[$i]}"
        echo "== build: $component =="
        (cd "$ROOT/mods/$component" && "$HEMTT" build)
        mkdir -p "$stage/$mod_dir"
        cp -a "$ROOT/mods/$component/.hemttout/build/." "$stage/$mod_dir/"
        built_pbo=$(find "$stage/$mod_dir/addons" -maxdepth 1 -type f -name '*.pbo' -print -quit)
        mv "$built_pbo" "$stage/$mod_dir/addons/$pbo_name.pbo"
    done
    rm -rf "$BUILD_ROOT/current"
    mv "$stage" "$BUILD_ROOT/current"
    trap - EXIT
    echo "Build complete: $BUILD_ROOT/current"
}

show_server_status() {
    python3 "$ROOT/tools/pontifex_server.py" status
}

case "${1:-help}" in
    multiplayer)
        if [[ "${2:-}" == "status" && $# -eq 2 ]]; then
            exec python3 "$ROOT/tools/pontifex_multiplayer.py" status
        fi
        usage
        exit 2
        ;;
    check) run_check ;;
    build) run_build ;;
    test)
        if [[ "${2:-}" == "smoke" || "${2:-}" == "integration" || "${2:-}" == "gameplay" || "${2:-}" == "capability" ]]; then
            tier="$2"
            shift 2
            exec python3 "$ROOT/tools/pontifex_multiplayer.py" tier "$tier" "$@"
        fi
        if [[ "${2:-}" == "live" ]]; then
            shift 2
            exec python3 "$ROOT/tools/pontifex_multiplayer.py" live-start "$@"
        fi
        if [[ "${2:-}" == "multiplayer" ]]; then
            shift 2
            exec python3 "$ROOT/tools/pontifex_multiplayer.py" test "$@"
        fi
        if [[ "${2:-}" == "dedicated" ]]; then
            shift 2
            exec python3 "$ROOT/tools/pontifex_server.py" test "$@"
        fi
        if [[ $# -ne 1 ]]; then
            usage
            exit 2
        fi
        run_check
        echo "PASS: fast/static checks"
        ;;
    status)
        if [[ -x "$HEMTT" ]]; then
            "$HEMTT" --version 2>&1 || true
        else
            echo "HEMTT: not bootstrapped (run ./pontifex check)"
        fi
        git -C "$ROOT" status --short --branch 2>/dev/null || echo "Git: not initialized"
        find "$BUILD_ROOT/current" -type f -name '*.pbo' -print 2>/dev/null || true
        show_server_status
        ;;
    server)
        case "${2:-status}" in
            status)
                show_server_status
                python3 "$ROOT/tools/pontifex_multiplayer.py" status
                ;;
            stop)
                python3 "$ROOT/tools/pontifex_server.py" stop
                exec python3 "$ROOT/tools/pontifex_multiplayer.py" stop
                ;;
            start)
                echo "Persistent/manual server start is reserved for a later interactive-test phase." >&2
                exit 2
                ;;
            *) usage; exit 2 ;;
        esac
        ;;
    client)
        exec python3 "$ROOT/tools/pontifex_multiplayer.py" client "${2:-status}"
        ;;
    manual)
        exec python3 "$ROOT/tools/pontifex_multiplayer.py" manual "${@:2}"
        ;;
    e2e)
        exec python3 "$ROOT/tools/pontifex_multiplayer.py" e2e "${@:2}"
        ;;
    live)
        exec python3 "$ROOT/tools/pontifex_multiplayer.py" live "${@:2}"
        ;;
    dependencies)
        exec python3 "$ROOT/tools/pontifex_server.py" dependencies "${2:-status}"
        ;;
    release)
        echo "Release is intentionally disabled until versioning and private-key handling are established." >&2
        exit 2
        ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
esac
